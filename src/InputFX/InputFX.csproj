<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\InputFX.ico</ApplicationIcon>
    <AssemblyName>InputFX</AssemblyName>
    <RootNamespace>InputFX</RootNamespace>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>CS8618;CS8600;CS8602;CS8604;CS0649;CA1416;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\layout.csv" LogicalName="layout.csv" />
    <EmbeddedResource Include="Assets\kb_cfg04.bin" LogicalName="kb_cfg04.bin" />
    <EmbeddedResource Include="Assets\kb_cfg84.bin" LogicalName="kb_cfg84.bin" />
    <EmbeddedResource Include="Assets\mouse_replay.bin" LogicalName="mouse_replay.bin" />
    <EmbeddedResource Include="Assets\InputFX.ico" LogicalName="InputFX.ico" />
  </ItemGroup>

</Project>
